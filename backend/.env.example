# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ── App ────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-string
ALLOWED_ORIGINS=["http://localhost:5173","https://your-username.github.io"]

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://quant:quant@localhost/quantdb

# ── Crypto ─────────────────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_SECRET=
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=

# ── US Stocks ───────────────────────────────────────────────────────────────
POLYGON_API_KEY=
ALPHA_VANTAGE_KEY=

# ── Taiwan Stocks ───────────────────────────────────────────────────────────
TW_BROKER_API_KEY=
TW_BROKER_SECRET=

# ── Notifications ────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
